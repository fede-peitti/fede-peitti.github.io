---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';

const cvUrl = '/cv.pdf';
---

<PageLayout
  title="CV"
  eyebrow="Curriculum vitae"
  lead="Background and experience."
  description="Curriculum vitae of Federico Peitti."
>
  <div class="cv">
    <a
      class="btn btn--accent cv-download"
      href={cvUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="file" size={18} /> Download PDF
    </a>

    <div class="cv-frame">
      <iframe
        src={cvUrl}
        title="CV (PDF)"
        loading="lazy"
        referrerpolicy="no-referrer"
      />
    </div>

    <a class="cv-mobile" href={cvUrl} target="_blank" rel="noopener noreferrer">
      <span class="cv-mobile-ic">
        <Icon name="file" size={26} />
      </span>
      <span class="cv-mobile-text">
        <strong>Open the CV full screen</strong>
        <span class="muted">Opens the PDF in your device's viewer</span>
      </span>
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</PageLayout>

<style>
  .cv-download {
    margin-bottom: var(--space-5);
  }

  .cv-frame {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
  }

  .cv-frame iframe {
    width: 100%;
    height: min(85vh, 1100px);
    border: none;
    display: block;
  }

  .cv-mobile {
    display: none;
  }

  @media (pointer: coarse), (max-width: 720px) {
    .cv-frame {
      display: none;
    }

    .cv-mobile {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.25rem 1.4rem;
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
      color: var(--color-ink);
    }

    .cv-mobile:hover {
      text-decoration: none;
      border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-rule));
    }

    .cv-mobile-ic {
      display: inline-flex;
      flex: none;
      color: var(--color-accent);
    }

    .cv-mobile-text {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      flex: 1;
    }

    .cv-mobile-text .muted {
      font-size: var(--fs-small);
    }
  }
</style>
