---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import PageScan from '../components/PageScan.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { ClientRouter } from 'astro:transitions';
import type { ScholarMeta } from '../lib/scholar';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  scholarMeta?: ScholarMeta;
  bare?: boolean;
}

const { title, description, image, type, noindex, scholarMeta, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (() => {
        const key = 'fp-theme';
        const root = document.documentElement;
        let theme = null;

        try {
          const saved = localStorage.getItem(key);
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch {}

        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }

        root.dataset.theme = theme;
        root.style.colorScheme = theme;
      })();
    </script>

    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
    />
    <ClientRouter />
  </head>

  <body>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready');
      }
    </script>

    {!bare && <ReadingProgress />}
    {!bare && <PageScan />}
    {!bare && <CommandPalette />}
    {!bare && <a href="#main" class="skip-link">Skip to content</a>}
    {!bare && <Header />}

    <script is:inline>
      (() => {
        const themeKey = 'fp-theme';
        const colors = {
          light: '#fafaf8',
          dark: '#0f1413',
        };

        const getRoot = () => document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');

        const validTheme = (value) => value === 'light' || value === 'dark';

        const storedTheme = () => {
          try {
            const value = localStorage.getItem(themeKey);
            return validTheme(value) ? value : null;
          } catch {
            return null;
          }
        };

        const systemTheme = () => (media.matches ? 'dark' : 'light');
        const resolvedTheme = () => storedTheme() || systemTheme();

        const syncControls = (theme) => {
          const nextLabel = theme === 'dark'
            ? 'Switch to light mode'
            : 'Switch to dark mode';

          for (const button of document.querySelectorAll('[data-theme-toggle]')) {
            button.dataset.themeState = theme;
            button.setAttribute('aria-label', nextLabel);
            button.setAttribute('title', nextLabel);
            button.setAttribute('aria-pressed', String(theme === 'dark'));
          }

          document.querySelectorAll('[data-theme-choice]').forEach((btn) => {
            const isActive = btn.dataset.themeChoice === theme;
            btn.setAttribute('aria-checked', String(isActive));
            btn.classList.toggle('is-active', isActive);
          });
        };

        const syncMeta = (theme, doc = document) => {
          const meta = doc.querySelector('[data-theme-color]');
          if (meta) meta.setAttribute('content', colors[theme] || colors.light);
        };

        const applyTheme = (theme, persist = false) => {
          const next = validTheme(theme) ? theme : systemTheme();
          const root = getRoot();

          if (persist) {
            try {
              localStorage.setItem(themeKey, next);
            } catch {}
          }

          root.dataset.theme = next;
          root.style.colorScheme = next;

          syncMeta(next);
          syncControls(next);

          document.dispatchEvent(
            new CustomEvent('fp:theme-change', { detail: { theme: next } })
          );

          return next;
        };

        if (!window.__fpTheme) {
          window.__fpTheme = {
            get: () => getRoot().dataset.theme || resolvedTheme(),
            apply: (theme) => applyTheme(theme, false),
            set: (theme) => applyTheme(theme, true),
            toggle: () => {
              const current = getRoot().dataset.theme || resolvedTheme();
              return applyTheme(current === 'dark' ? 'light' : 'dark', true);
            },
            sync: () => applyTheme(resolvedTheme(), false),
          };

          media.addEventListener('change', () => {
            if (!storedTheme()) applyTheme(systemTheme(), false);
          });

          document.addEventListener('astro:before-swap', (event) => {
            const theme = getRoot().dataset.theme || resolvedTheme();
            const nextDocument = event.newDocument;

            if (!nextDocument) return;

            nextDocument.documentElement.dataset.theme = theme;
            nextDocument.documentElement.style.colorScheme = theme;
            syncMeta(theme, nextDocument);
          });

          document.addEventListener('astro:page-load', () => {
            window.__fpTheme.sync();
          });
        }

        window.__fpTheme.sync();
      })();
    </script>

    <main id="main" class:list={[bare && 'main--bare']}>
      <slot />
    </main>

    {!bare && <Footer />}

    <script>
      import { prefersReducedMotion, onVisible } from '../scripts/motion';

      let stoppers: Array<() => void> = [];

      function reveal() {
        if (prefersReducedMotion()) return;

        const observe = (selector: string, cls: string) => {
          for (const el of document.querySelectorAll(selector)) {
            let stop = () => {};

            stop = onVisible(el, () => {
              el.classList.add(cls);
              stop();
            });

            stoppers.push(stop);
          }
        };

        observe('[data-reveal]', 'is-visible');
        observe('[data-pulse]', 'is-pulsed');
      }

      function teardown() {
        for (const stop of stoppers) stop();
        stoppers = [];
      }

      document.addEventListener('astro:page-load', reveal);
      document.addEventListener('astro:before-swap', teardown);
    </script>
  </body>
</html>
